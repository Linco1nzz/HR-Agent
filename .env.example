# =============================================================================
# HR-Agent 本地开发环境变量模板
# 用法：cp .env.example .env 然后修改 POSTGRES_PASSWORD
# =============================================================================

# --- 数据库账号 ---
POSTGRES_USER=hr_agent_user
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=hr_agent

# 宿主机端口。若本机已有 PostgreSQL 占用 5432，改成 5433 等空闲端口。
POSTGRES_PORT=5433

# --- 时区 ---
TZ=Asia/Shanghai

# --- 数据库参数（可按机器内存调整）---
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_LOG_MIN_DURATION_MS=500

# --- Redis（缓存 / Celery broker）---
# 密码需与 backend/.env 中 REDIS_URL 里的密码一致
REDIS_PASSWORD=change-me-please
# 宿主机端口。若本机已有 Redis 占用 6379，改成 6380 等空闲端口，
# 并同步修改 backend/.env 的 REDIS_URL
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# --- 镜像 ---
PGVECTOR_IMAGE=pgvector/pgvector:pg17
REDIS_IMAGE=redis:8-alpine
