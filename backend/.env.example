# =============================================================================
# 后端应用运行时配置（由后端框架加载，例如 pydantic-settings / python-dotenv /
# NestJS ConfigModule）。请复制为 backend/.env 后按需修改：
#     cp .env.example .env
#
# 说明：
#  - 本文件只放「应用」需要的东西；
#  - 数据库容器的账号/端口等基础设施配置在仓库根目录 .env（由 docker compose 读取）；
#  - 两边的数据库账号密码需保持一致（当前为 hr_agent_user / hr_agent_password）；
#  - 将来后端容器化后，DATABASE_URL 改由 compose 注入，这里就不用再写 DB 凭据了。
# =============================================================================

# --- 应用 ---
APP_NAME=HR Agent
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=18080
API_V1_PREFIX=/api/v1
APP_ENV=development

# --- 安全配置 ---
# HS256 建议密钥不短于 32 字节；生产环境务必替换为随机密钥
JWT_SECRET=change-me-in-production-please-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 密码哈希（Argon2id）---
# 内存单位 KiB；默认 32 MiB / 2 次迭代 / 2 并行度，可按机器性能调整
# ARGON2_TIME_COST=2
# ARGON2_MEMORY_COST=32768
# ARGON2_PARALLELISM=2

# --- 数据库 ---
# 本机开发：连 Docker 里的 PostgreSQL（宿主机端口 5433，因 5432 被原生 PG 16 占用）
DATABASE_URL=postgresql+psycopg://hr_agent_user:hr_agent_password@localhost:5433/hr_agent

# 若后端也跑在 Docker 且加入 hr-agent-net 网络，改用容器内地址：
# DATABASE_URL=postgresql://hr_agent_user:hr_agent_password@pg:5432/hr_agent

# 单独拆开的写法（部分框架需要）：
DB_HOST=localhost
DB_PORT=5433
DB_USER=hr_agent_user
DB_PASSWORD=hr_agent_password
DB_NAME=hr_agent

# 日志配置
LOG_LEVEL=INFO

# --- 第三方密钥（按实际需要填写，不要提交 .env）---
# 知识库语义分割点：DeepSeek（系统环境变量优先）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MAX_TOKENS=2048
# DEEPSEEK_REASONING_EFFORT=low
# DEEPSEEK_TIMEOUT_SECONDS=120
# 知识库向量化：阿里云百炼（DashScope 兼容模式，系统环境变量优先）
# DASHSCOPE_API_KEY=
# EMBEDDING_BASE_URL=https://llm-krcikrn4mpgwujad.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=qwen3.7-text-embedding
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=16
# 知识库分块向量：LangChain PGVector（langchain_pg_embedding 表）
# PGVECTOR_COLLECTION_NAME=hr_agent_kb_chunks
# JWT_SECRET=

# --- Dify Chatflow（advanced-chat 应用）---
# 地址必须包含 /v1；本地 Dify 通过 nginx 暴露在 80 端口
DIFY_BASE_URL=http://127.0.0.1/v1
# Dify 应用「API 访问」密钥，app- 开头；不要提交到版本库
DIFY_API_KEY=
# 单次工作流最长等待时间（秒）与连接超时（秒）
DIFY_TIMEOUT_SECONDS=120
DIFY_CONNECT_TIMEOUT_SECONDS=5

# --- 简历上传 ---
# 简历文件保存目录（相对路径按 backend/ 解析）；不要提交到版本库
RESUME_UPLOAD_DIR=uploads/resumes
# 单份简历允许的最大体积（MB）
RESUME_MAX_FILE_SIZE_MB=10

# --- 知识库文档上传与切块 ---
# 文档保存目录（相对路径按 backend/ 解析）；不要提交到版本库
KNOWLEDGE_BASE_UPLOAD_DIR=uploads/knowledge_bases
# 单份文档允许的最大体积（MB）
KNOWLEDGE_BASE_MAX_FILE_SIZE_MB=20
# 单个分块的目标长度 / 相邻重叠长度（字符）
KNOWLEDGE_BASE_CHUNK_SIZE=800
KNOWLEDGE_BASE_CHUNK_OVERLAP=120
# 小于该长度的分块尽量并入前一块
KNOWLEDGE_BASE_MIN_CHUNK_CHARS=80
# 单份文档最多保留的分块数量
KNOWLEDGE_BASE_MAX_CHUNKS=500
